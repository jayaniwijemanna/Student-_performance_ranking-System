# Root .gitignore for Fullstack Spring Boot + React Vite project

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Java / Gradle / Backend
backend/.gradle/
backend/build/
backend/out/
backend/bin/
backend/*.log
backend/HELP.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath
.springBeans
.sts4-cache
.apt_generated

# OS System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
